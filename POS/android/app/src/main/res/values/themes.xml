<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Black ground and no action bar: the web app draws its own topbar, and the
      dark background stops a white flash before the first paint.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:colorPrimary">@color/ink</item>
    </style>
</resources>
