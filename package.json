{
  "name": "hot-n-hazy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "vite",
    "build": "pnpm sync:menu && tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync:menu": "node tools/sync-menu.mjs",
    "check-menu": "node tools/sync-menu.mjs --check",
    "typecheck": "tsc --noEmit",
    "check-env": "node tools/check-env.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
