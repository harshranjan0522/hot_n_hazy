# Copy to .env and fill in. Only VITE_-prefixed vars reach the browser bundle —
# never put a secret behind a VITE_ prefix.

# Public site URL, used for canonical links and OG tags.
VITE_SITE_URL="http://localhost:5173"

# Human-readable site name.
VITE_SITE_NAME="Hot n' Hazy"

# Optional: analytics id. Leave empty to disable.
VITE_ANALYTICS_ID=""
